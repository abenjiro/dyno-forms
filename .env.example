# Dyno Forms — Environment Configuration Template

# Server & Host Port Mapping (Avoids conflict with other containers)
PORT=3050
APP_PORT=3050
MOCK_API_PORT=4050

# Mock API Endpoint (Used in dev container or local dev)
NEXT_PUBLIC_MOCK_API_URL=http://localhost:4050

# Feature Flags (Control public vs. internal features)
NEXT_PUBLIC_FEATURE_AI_CONVERTER=true
NEXT_PUBLIC_FEATURE_DRAFT_AUTOSAVE=true
NEXT_PUBLIC_FEATURE_DYNAMIC_APIS=true

# AI Document Ingestion Provider (Optional: for live AI conversion; mock fallback works without key)
AI_PROVIDER=gemini
AI_API_KEY=
