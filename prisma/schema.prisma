generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  phone        String?
  avatarUrl    String?
  role         String   @default("creator") // superadmin, creator, member
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedOrganizations       Organization[]       @relation("UserOwnedOrganizations")
  organizationMemberships  OrganizationMember[]
  createdForms             Form[]               @relation("UserCreatedForms")
  submissions              Submission[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  owner      User                 @relation("UserOwnedOrganizations", fields: [ownerId], references: [id], onDelete: Cascade)
  members    OrganizationMember[]
  formGroups FormGroup[]
  forms      Form[]

  @@map("organizations")
}

model OrganizationMember {
  id       String   @id @default(cuid())
  orgId    String
  userId   String
  role     String   @default("member") // owner, admin, editor, viewer
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model FormGroup {
  id          String   @id @default(cuid())
  orgId       String
  name        String   // e.g. "2025/2026 Admissions"
  slug        String
  description String?
  createdAt   DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  forms    Form[]
  vouchers Voucher[]

  @@unique([orgId, slug])
  @@map("form_groups")
}

model Form {
  id              String    @id // Custom or generated ID, e.g. "form_adm_undergrad"
  orgId           String
  groupId         String?
  createdById     String?
  title           String
  slug            String
  description     String?
  status          String    @default("draft") // draft, published, closed, archived
  currentVersion  Int       @default(1)
  schema          Json      // Dyno AST FormSchema JSON
  settings        Json      // Dyno FormSettings JSON
  pricingConfig   Json?     // Payment configuration: access mode, base price, fees, bearer
  expiresAt       DateTime? // Auto-close timestamp
  submissionLimit Int?      // Response quota cap
  submissionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group      FormGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("UserCreatedForms", fields: [createdById], references: [id], onDelete: SetNull)
  submissions Submission[]
  drafts     Draft[]
  vouchers   Voucher[]
  payments   Payment[]
  apiSecrets ApiSecret[]

  @@unique([orgId, slug])
  @@index([status])
  @@map("forms")
}

model Submission {
  id              String   @id // e.g. "sub_x89a_17290000"
  formId          String
  formVersion     Int      @default(1)
  submitterId     String?
  data            Json     // Form responses object Record<string, any>
  paymentStatus   String   @default("free") // free, unpaid, paid, voucher_waived
  voucherCode     String?
  ipHash          String?
  userAgent       String?
  submittedAt     DateTime @default(now())

  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitter User?     @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([formId])
  @@index([submittedAt])
  @@map("submissions")
}

model Draft {
  id           String    @id // e.g. "draft_x9a8"
  formId       String
  resumeToken  String    @unique
  email        String?
  phone        String?
  otpHash      String?
  otpExpiresAt DateTime?
  values       Json      // Draft values Record<string, any>
  schema       Json?     // Draft schema snapshot
  progress     Int       @default(0)
  savedAt      DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([email])
  @@index([phone])
  @@map("drafts")
}

model Voucher {
  id            String    @id @default(cuid())
  formId        String?
  groupId       String?
  codeHash      String    @unique
  codeMasked    String    // e.g. "ADM-***-X9K"
  batchName     String?   // e.g. "Bank Branch Sales Batch 1"
  discountType  String    @default("full_waiver") // full_waiver, fixed_amount, percentage
  discountValue Float     @default(0)
  maxUses       Int       @default(1)
  timesUsed     Int       @default(0)
  expiresAt     DateTime?
  status        String    @default("active") // active, exhausted, revoked, expired
  createdAt     DateTime  @default(now())

  form        Form?               @relation(fields: [formId], references: [id], onDelete: Cascade)
  group       FormGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  redemptions VoucherRedemption[]

  @@index([status])
  @@map("vouchers")
}

model VoucherRedemption {
  id              String   @id @default(cuid())
  voucherId       String
  submissionId    String?
  redeemedByEmail String?
  redeemedAt      DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@map("voucher_redemptions")
}

model Payment {
  id               String    @id @default(cuid())
  formId           String
  submissionId     String?
  payerEmail       String?
  payerPhone       String?
  basePrice        Float
  platformFee      Float     // Dyno Forms platform revenue
  gatewayFee       Float     // Gateway / Telco / MoMo fee
  totalCharged     Float     // Gross amount charged
  creatorNet       Float     // Net amount owed to creator
  feeBearer        String    // "client" (buyer pays extra) or "creator" (deducted from payout)
  currency         String    @default("USD")
  gateway          String    // "stripe", "paystack", "flutterwave", "momo"
  gatewayReference String?   @unique
  status           String    @default("pending") // pending, successful, failed, refunded
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  form       Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([status])
  @@map("payments")
}

model ApiSecret {
  id              String   @id @default(cuid())
  formId          String
  fieldId         String
  authType        String   // bearer, api_key, basic
  headerName      String   @default("Authorization")
  encryptedSecret String   // AES-256-GCM ciphertext
  iv              String
  authTag         String
  createdAt       DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldId])
  @@map("api_secrets")
}
