generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  superadmin
  creator
  member
}

enum OrgRole {
  owner
  admin
  editor
  viewer
  member
}

enum FormStatus {
  draft
  published
  closed
  archived
  soft_deleted
}

enum PaymentStatus {
  free
  unpaid
  pending
  paid
  failed
  refunded
  voucher_waived
}

enum FeeBearer {
  client
  creator
}

enum PaymentGateway {
  stripe
  paystack
  flutterwave
  momo
}

enum VoucherDiscountType {
  full_waiver
  fixed_amount
  percentage
}

enum VoucherStatus {
  active
  exhausted
  revoked
  expired
}

enum ApiAuthType {
  bearer
  api_key
  basic
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  fullName     String?
  phone        String?
  avatarUrl    String?
  role         UserRole  @default(creator)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownedOrganizations      Organization[]       @relation("UserOwnedOrganizations")
  organizationMemberships OrganizationMember[]
  createdForms            Form[]               @relation("UserCreatedForms")
  submissions             Submission[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())

  owner      User                 @relation("UserOwnedOrganizations", fields: [ownerId], references: [id], onDelete: Cascade)
  members    OrganizationMember[]
  formGroups FormGroup[]
  forms      Form[]

  @@map("organizations")
}

model OrganizationMember {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @db.Uuid
  userId   String   @db.Uuid
  role     OrgRole  @default(member)
  joinedAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model FormGroup {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String   // e.g. "2025/2026 Admissions"
  slug        String
  description String?
  createdAt   DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  forms    Form[]
  vouchers Voucher[]

  @@unique([orgId, slug])
  @@map("form_groups")
}

model Form {
  id              String     @id @default(uuid()) @db.Uuid
  orgId           String     @db.Uuid
  groupId         String?    @db.Uuid
  createdById     String?    @db.Uuid
  title           String
  slug            String
  description     String?
  status          FormStatus @default(draft)
  currentVersion  Int        @default(1)
  schema          Json       // Dyno AST FormSchema JSON
  settings        Json       // Dyno FormSettings JSON
  pricingConfig   Json?      // Payment configuration: access mode, base price, fees, bearer
  expiresAt       DateTime?  // Auto-close timestamp
  submissionLimit Int?       // Response quota cap
  submissionCount Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group       FormGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("UserCreatedForms", fields: [createdById], references: [id], onDelete: SetNull)
  submissions Submission[]
  drafts      Draft[]
  vouchers    Voucher[]
  payments    Payment[]
  apiSecrets  ApiSecret[]

  @@unique([orgId, slug])
  @@index([status])
  @@map("forms")
}

model Submission {
  id            String        @id @default(uuid()) @db.Uuid
  formId        String        @db.Uuid
  formVersion   Int           @default(1)
  submitterId   String?       @db.Uuid
  voucherId     String?       @db.Uuid
  data          Json          // Form responses object Record<string, any>
  paymentStatus PaymentStatus @default(free)
  voucherCode   String?
  ipHash        String?
  userAgent     String?
  submittedAt   DateTime      @default(now())

  form               Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitter          User?               @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  voucher            Voucher?            @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherRedemptions VoucherRedemption[]
  payments           Payment[]

  @@index([formId])
  @@index([submittedAt])
  @@map("submissions")
}

model Draft {
  id           String    @id @default(uuid()) @db.Uuid
  formId       String    @db.Uuid
  resumeToken  String    @unique
  email        String?
  phone        String?
  otpHash      String?
  otpExpiresAt DateTime?
  values       Json      // Draft values Record<string, any>
  schema       Json?     // Draft schema snapshot
  progress     Int       @default(0)
  savedAt      DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([email])
  @@index([phone])
  @@map("drafts")
}

model Voucher {
  id            String              @id @default(uuid()) @db.Uuid
  formId        String?             @db.Uuid
  groupId       String?             @db.Uuid
  codeHash      String              @unique
  codeMasked    String              // e.g. "ADM-***-X9K"
  batchName     String?             // e.g. "Bank Branch Sales Batch 1"
  discountType  VoucherDiscountType @default(full_waiver)
  discountValue Decimal             @default(0) @db.Decimal(10, 2)
  maxUses       Int                 @default(1)
  timesUsed     Int                 @default(0)
  expiresAt     DateTime?
  status        VoucherStatus       @default(active)
  createdAt     DateTime            @default(now())

  form        Form?               @relation(fields: [formId], references: [id], onDelete: Cascade)
  group       FormGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions Submission[]
  redemptions VoucherRedemption[]

  @@index([status])
  @@map("vouchers")
}

model VoucherRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  voucherId       String   @db.Uuid
  submissionId    String?  @db.Uuid
  redeemedByEmail String?
  redeemedAt      DateTime @default(now())

  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([voucherId])
  @@index([submissionId])
  @@map("voucher_redemptions")
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  formId           String         @db.Uuid
  submissionId     String?        @db.Uuid
  payerEmail       String?
  payerPhone       String?
  basePrice        Decimal        @db.Decimal(10, 2)
  platformFee      Decimal        @db.Decimal(10, 2)
  gatewayFee       Decimal        @db.Decimal(10, 2)
  totalCharged     Decimal        @db.Decimal(10, 2)
  creatorNet       Decimal        @db.Decimal(10, 2)
  feeBearer        FeeBearer
  currency         String         @default("USD")
  gateway          PaymentGateway
  gatewayReference String?        @unique
  status           PaymentStatus  @default(pending)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  form       Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([status])
  @@map("payments")
}

model ApiSecret {
  id              String      @id @default(uuid()) @db.Uuid
  formId          String      @db.Uuid
  fieldId         String
  authType        ApiAuthType @default(bearer)
  headerName      String      @default("Authorization")
  encryptedSecret String      // AES-256-GCM ciphertext
  iv              String
  authTag         String
  createdAt       DateTime    @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldId])
  @@map("api_secrets")
}
